# MongoDB Atlas 연결 문자열. 없으면 공지·묻고답하기는 JSON, 문의·회원·직원·CMS는 로컬 파일로 동작합니다.
MONGODB_URI=
MONGODB_DB=MP-Anyang

# 공개 사이트 주소. 커스텀 도메인 전까지 Render 기본 URL을 씁니다.
SITE_URL=https://mp-anyang.onrender.com

# 선택. 이미지 CDN 오리진. 비우면 이 앱의 /images 와 /images/thumbs 를 씁니다.
IMAGE_CDN_BASE=
NEXT_PUBLIC_IMAGE_CDN_BASE=

# 문의 수신 메일. 없으면 문의는 DB(또는 로컬 파일)에만 저장됩니다. 관리 답변 메모는 메일로 보내지 않습니다.
INQUIRY_INBOX=

# 선택. 세션 서명. 비우면 로컬 기본값을 씁니다. 공개 서비스에서는 꼭 넣으세요.
AUTH_SECRET=

# 감독·관리자 시드. 값은 환경변수로만 넣고 git에 평문 비번을 적지 마세요.
# ADMIN_SEED 형식: username:password,username:password
# Render에도 SUPERVISOR_ID / SUPERVISOR_PASSWORD 를 넣으세요. Mongo가 없어도 로그인 시 로컬 직원 파일을 만듭니다.
# Mongo URI만 있고 시드 환경변수가 비어 있으면 감독 로그인이 되지 않습니다.
SUPERVISOR_ID=
SUPERVISOR_PASSWORD=
ADMIN_SEED=

# 카카오·구글 간편로그인. 값은 Render(또는 .env.local)에만 넣으세요. git에 넣지 마세요.
# 콜백: {SITE_URL}/api/auth/callback/kakao 와 {SITE_URL}/api/auth/callback/google
# 별칭: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, AUTH_KAKAO_ID, AUTH_KAKAO_SECRET, KAKAO_CLIENT_ID
# GOOGLE_CLIENT_EMAIL 은 서비스 계정용이며 로그인 코드 교환에는 쓰지 않습니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 소셜 프로필. 비우면 홈 로고 버튼은 전화·오시는 길·분양가·관리비로 갑니다. 주소를 지어내지 마세요.
FACEBOOK=
INSTAGRAM=
YOUTUBE=
CAFE=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_CAFE_URL=
