# MongoDB Atlas 연결 문자열. 없으면 공지·묻고답하기는 JSON, 문의·직원·CMS는 로컬 파일로 동작합니다.
MONGODB_URI=
MONGODB_DB=MP-Anyang

# 공개 사이트 주소. 커스텀 도메인 전까지 Render 기본 URL을 씁니다.
SITE_URL=https://mp-anyang.onrender.com

# 선택. 이미지 CDN 오리진 (Render 부하·속도 개선). public/images 를 CDN에 올린 뒤 동일 경로로 맞춥니다.
# 예: https://cdn.example.com  →  /images/hero.jpg 는 CDN의 /images/hero.jpg
IMAGE_CDN_BASE=
NEXT_PUBLIC_IMAGE_CDN_BASE=

# 문의 수신 메일. 없으면 문의는 DB(또는 로컬 파일)에만 저장됩니다. 관리 답변 메모는 메일로 보내지 않습니다.
INQUIRY_INBOX=

# 선택. 세션 서명. 비우면 로컬 기본값을 씁니다. 공개 서비스에서는 꼭 넣으세요.
AUTH_SECRET=

# 직원 시드. 값은 환경변수로만 넣고 git에 평문 비번을 적지 마세요.
# ADMIN_SEED 형식: username:password,username:password
# Render에도 SUPERVISOR_ID / SUPERVISOR_PASSWORD / CEO_ID / CEO_PASSWORD 를 넣으세요.
SUPERVISOR_ID=
SUPERVISOR_PASSWORD=
ADMIN_SEED=
CEO_ID=
CEO_PASSWORD=

# 원본 업무프로그램(읽기 전용 복사). git에 값을 넣지 마세요.
CEMETERY_SOURCE_URL=http://1.255.226.45:88/Cemetery
CEMETERY_SOURCE_COMPANY=002
CEMETERY_SOURCE_ID=
CEMETERY_SOURCE_PASSWORD=

# Render Cron Job이 /api/cron/work-sync 를 칠 때. git에 값을 넣지 마세요.
CRON_SECRET=

# 소셜 프로필. 비우면 site.ts SOCIAL_URLS → 없으면 푸터 아이콘은 전화·오시는 길 등 내부 링크로 갑니다.
# Render 등에서 덮어쓰려면 NEXT_PUBLIC_* 사용 (빌드 시 반영).
FACEBOOK=https://www.facebook.com/profile.php?id=61595231941222
INSTAGRAM=https://www.instagram.com/anyangmp/
YOUTUBE=https://www.youtube.com/channel/UCnMpOKXKjlrDnVtWHZUH_wA
BLOG=https://blog.naver.com/ahnyangmp
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_BLOG_URL=
